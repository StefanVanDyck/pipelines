  <distributionManagement>
    <repository>
      <id>gbif-release</id>
      <url>https://repository.gbif.org/content/repositories/releases</url>
    </repository>
    <snapshotRepository>
      <id>gbif-deploy</id>
      <url>https://repository.gbif.org/content/repositories/snapshots</url>
    </snapshotRepository>
    <site>
      <id>gh-pages</id>
      <url>https://gbif.github.io/download-query-tools/</url>
    </site>
  </distributionManagement>
  <properties>
    <jackson.version>2.19.4</jackson.version>
    <calcite.version>1.35.0</calcite.version>
    <slf4j.version>2.0.17</slf4j.version>
    <commons-lang3.version>3.20.0</commons-lang3.version>
    <junit.version>5.12.2</junit.version>
    <logback.version>1.5.21</logback.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven-shade-plugin.version>3.5.1</maven-shade-plugin.version>
    <mockito.version>5.20.0</mockito.version>
    <jts.version>1.19.0</jts.version>
    <maven.compiler.target>17</maven.compiler.target>
    <gbif-api.version>2.4.7</gbif-api.version>
  </properties>
</project>
